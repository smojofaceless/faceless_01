# Environment Variables for Video Renderer
# Copy this file to .env and fill in your values

# Server port (default: 3001)
PORT=3001

# Temporary directories for processing
TEMP_DIR=/tmp/renders
OUTPUT_DIR=/tmp/outputs

# Supabase credentials (required for uploading final videos)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# Maximum concurrent renders (reduce for low-memory servers)
MAX_CONCURRENT_RENDERS=1

# ─── ComfyUI Local Generation ───
# Optional: Enable local image generation via ComfyUI (Phase 1)
# Set image_model: "comfyui" in brand DNA or job meta to activate
COMFYUI_URL=http://127.0.0.1:8188
COMFYUI_TIMEOUT_MS=300000           # 5 min per image max (cold checkpoint load can take 2-3 min)
COMFYUI_MAX_QUEUE=6                 # if ComfyUI queue >= this → cloud fallback
COMFYUI_MIN_VRAM_MB=2048            # if free VRAM < this → cloud fallback (low because ComfyUI auto-offloads)
COMFYUI_DEFAULT_WORKFLOW=txt2img_sdxl
COMFYUI_DEFAULT_CHECKPOINT=         # blank = ComfyUI's default checkpoint
COMFYUI_SKIP_WARMUP=0               # set to 1 to skip startup checkpoint pre-load

# Supabase credentials (required for uploading ComfyUI images to Storage)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# Image-to-video (Phase 2) — separate limits
COMFYUI_MIN_VRAM_MB_IMG2VID=4096    # higher VRAM floor for video generation
COMFYUI_MAX_QUEUE_IMG2VID=2         # tighter queue limit (video is 10-30× slower)
COMFYUI_TIMEOUT_MS_IMG2VID=300000   # 5 min per clip (vs 2 min for images)
