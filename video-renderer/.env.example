# Environment Variables for Video Renderer
# Copy this file to .env and fill in your values

# Server port (default: 3001)
PORT=3001

# Temporary directories for processing
TEMP_DIR=/tmp/renders
OUTPUT_DIR=/tmp/outputs

# Supabase credentials (required for uploading final videos)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# Maximum concurrent renders (reduce for low-memory servers)
MAX_CONCURRENT_RENDERS=1
