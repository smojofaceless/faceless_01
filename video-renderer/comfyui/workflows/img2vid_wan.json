{
  "_meta": {
    "title": "Wan2.1 I2V 14B (FP8) — API Workflow",
    "description": "Image-to-video using Wan2.1-I2V-14B FP8 quantized. Supports human motion and complex scenes. Uses block swap (20 blocks) for 12GB VRAM."
  },
  "1": {
    "class_type": "WanVideoBlockSwap",
    "_note": "Block swap config: offload 20 of 40 transformer blocks to CPU for 12GB VRAM. Outputs BLOCKSWAPARGS → feeds into ModelLoader.",
    "inputs": {
      "blocks_to_swap": 30,
      "offload_img_emb": true,
      "offload_txt_emb": true
    }
  },
  "2": {
    "class_type": "WanVideoModelLoader",
    "_note": "Load Wan2.1 I2V 14B FP8 model with block swap for VRAM savings",
    "inputs": {
      "model": "Wan2_1-I2V-14B-480P_fp8_e4m3fn.safetensors",
      "base_precision": "bf16",
      "quantization": "disabled",
      "load_device": "offload_device",
      "block_swap_args": ["1", 0]
    }
  },
  "3": {
    "class_type": "WanVideoVAELoader",
    "_note": "Wan2.1 VAE for encode/decode",
    "inputs": {
      "model_name": "Wan2_1_VAE_bf16.safetensors",
      "precision": "bf16"
    }
  },
  "4": {
    "class_type": "LoadWanVideoT5TextEncoder",
    "_note": "T5-XXL text encoder (FP8 quantized)",
    "inputs": {
      "model_name": "umt5-xxl-enc-fp8_e4m3fn.safetensors",
      "precision": "bf16"
    }
  },
  "5": {
    "class_type": "WanVideoTextEncode",
    "_note": "Encode positive and negative prompts via T5",
    "inputs": {
      "positive_prompt": "cinematic motion, gentle movement, atmospheric",
      "negative_prompt": "static, blurry, distorted, low quality, jittery, flickering",
      "t5": ["4", 0],
      "force_offload": true
    }
  },
  "6": {
    "class_type": "LoadImage",
    "_note": "Source image uploaded to ComfyUI input/ directory",
    "inputs": {
      "image": "INPUT_IMAGE_PLACEHOLDER"
    }
  },
  "7": {
    "class_type": "CLIPVisionLoader",
    "_note": "CLIP Vision model for image embedding",
    "inputs": {
      "clip_name": "open-clip-xlm-roberta-large-vit-huge-14_visual_fp16.safetensors"
    }
  },
  "8": {
    "class_type": "WanVideoClipVisionEncode",
    "_note": "Encode source image with CLIP vision for I2V conditioning. Returns WANVIDIMAGE_CLIPEMBEDS.",
    "inputs": {
      "clip_vision": ["7", 0],
      "image_1": ["6", 0],
      "strength_1": 1.0,
      "strength_2": 1.0,
      "crop": "center",
      "combine_embeds": "average",
      "force_offload": true
    }
  },
  "9": {
    "class_type": "WanVideoImageToVideoEncode",
    "_note": "Encode source image to Wan latents with CLIP embeds; 480P, 81 frames = ~5s at 16fps. Returns WANVIDIMAGE_EMBEDS.",
    "inputs": {
      "width": 832,
      "height": 480,
      "num_frames": 81,
      "noise_aug_strength": 0.0263,
      "start_latent_strength": 1.0,
      "end_latent_strength": 1.0,
      "force_offload": true,
      "vae": ["3", 0],
      "clip_embeds": ["8", 0],
      "start_image": ["6", 0]
    }
  },
  "10": {
    "class_type": "WanVideoSampler",
    "_note": "Main sampler — generates video frames. 30 steps, cfg=6, shift=5. Takes WANVIDIMAGE_EMBEDS from I2V encode.",
    "inputs": {
      "model": ["2", 0],
      "image_embeds": ["9", 0],
      "steps": 30,
      "cfg": 6.0,
      "shift": 5.0,
      "seed": 0,
      "force_offload": true,
      "scheduler": "unipc",
      "riflex_freq_index": 0,
      "text_embeds": ["5", 0],
      "denoise_strength": 1.0
    }
  },
  "11": {
    "class_type": "WanVideoDecode",
    "_note": "Decode latents to pixel frames with VAE tiling for VRAM savings",
    "inputs": {
      "vae": ["3", 0],
      "samples": ["10", 0],
      "enable_vae_tiling": true,
      "tile_x": 128,
      "tile_y": 128,
      "tile_stride_x": 64,
      "tile_stride_y": 64
    }
  },
  "12": {
    "class_type": "SaveImage",
    "_note": "Save output frames for retrieval",
    "inputs": {
      "images": ["11", 0],
      "filename_prefix": "wan21_output"
    }
  }
}
