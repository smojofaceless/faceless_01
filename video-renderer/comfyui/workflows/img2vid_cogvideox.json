{
  "_meta": {
    "title": "CogVideoX 1.5-5B I2V (GGUF Q4) — API Workflow",
    "description": "Image-to-video using CogVideoX 1.5-5B-I2V GGUF Q4 quantized model via CLIPLoader + T5-XXL, with post-decode sharpening."
  },
  "9": {
    "class_type": "CLIPLoader",
    "_note": "Load T5-XXL text encoder for CogVideoX text conditioning",
    "inputs": {
      "clip_name": "t5xxl_fp8_e4m3fn.safetensors",
      "type": "sd3"
    }
  },
  "1": {
    "class_type": "DownloadAndLoadCogVideoGGUFModel",
    "_note": "Load CogVideoX-5B-I2V GGUF Q4 model (outputs: [0]=COGVIDEOMODEL, [1]=VAE)",
    "inputs": {
      "model": "CogVideoX_5b_1_5_I2V_GGUF_Q4_0.safetensors",
      "vae_precision": "bf16",
      "fp8_fastmode": false,
      "load_device": "main_device",
      "enable_sequential_cpu_offload": false
    }
  },
  "2": {
    "class_type": "CogVideoTextEncode",
    "_note": "Positive prompt (clip from CLIPLoader node 9, output [1]=CLIP chains to neg)",
    "inputs": {
      "clip": ["9", 0],
      "prompt": "cinematic motion, gentle movement, atmospheric",
      "strength": 1.0,
      "force_offload": true
    }
  },
  "3": {
    "class_type": "CogVideoTextEncode",
    "_note": "Negative prompt (clip chained from positive encode output [1])",
    "inputs": {
      "clip": ["2", 1],
      "prompt": "static, blurry, distorted, low quality, jittery, flickering",
      "strength": 1.0,
      "force_offload": true
    }
  },
  "4": {
    "class_type": "LoadImage",
    "_note": "Source image uploaded to ComfyUI input/ directory",
    "inputs": {
      "image": "INPUT_IMAGE_PLACEHOLDER"
    }
  },
  "10": {
    "class_type": "ImageScale",
    "_note": "Resize source image to target render dimensions before encoding",
    "inputs": {
      "image": ["4", 0],
      "upscale_method": "lanczos",
      "width": 480,
      "height": 720,
      "crop": "center"
    }
  },
  "5": {
    "class_type": "CogVideoImageEncode",
    "_note": "Encode source image for I2V conditioning (vae from node 1 output [1])",
    "inputs": {
      "vae": ["1", 1],
      "start_image": ["10", 0],
      "enable_tiling": false,
      "noise_aug_strength": 0.02,
      "strength": 1.0,
      "start_percent": 0.0,
      "end_percent": 1.0
    }
  },
  "6": {
    "class_type": "CogVideoSampler",
    "_note": "Main sampler — 49 frames @ 8fps = ~6s. CFG 6.0, 30 steps.",
    "inputs": {
      "model": ["1", 0],
      "positive": ["2", 0],
      "negative": ["3", 0],
      "image_cond_latents": ["5", 0],
      "num_frames": 49,
      "steps": 30,
      "cfg": 6.0,
      "seed": 0,
      "scheduler": "CogVideoXDDIM",
      "denoise_strength": 1.0
    }
  },
  "7": {
    "class_type": "CogVideoDecode",
    "_note": "Decode latents to image frames with VAE tiling",
    "inputs": {
      "vae": ["1", 1],
      "samples": ["6", 0],
      "enable_vae_tiling": true,
      "tile_sample_min_height": 240,
      "tile_sample_min_width": 360,
      "tile_overlap_factor_height": 0.2,
      "tile_overlap_factor_width": 0.2,
      "auto_tile_size": true
    }
  },
  "11": {
    "class_type": "ImageSharpen",
    "_note": "Post-decode sharpening to counteract Q4 GGUF softness",
    "inputs": {
      "image": ["7", 0],
      "sharpen_radius": 1,
      "sigma": 1.0,
      "alpha": 1.5
    }
  },
  "8": {
    "class_type": "SaveImage",
    "_note": "Save output frames for retrieval",
    "inputs": {
      "images": ["11", 0],
      "filename_prefix": "cogvideox_output"
    }
  }
}
